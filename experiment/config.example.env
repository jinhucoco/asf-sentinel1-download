# ============================================================
# SBAS-InSAR full-chain experiment config
# Copy from config.example.env and edit paths for your machine.
# NOTE: keep comments ASCII (cmd for /f parses with GBK codepage,
# UTF-8 Chinese in comments can swallow newlines and break parsing)
# ============================================================

# ---- work dirs ----
WORK_DIR=D:/work/data
RESULT_ROOT=G:/gulang2_result_SBAS_processing
TMP_DIR=G:/gulang2_result_SBAS_processing/tmp

# ---- data ----
SLC_DATA=E:/gulangoutdata2
# SLC import (step 0, run_import_slc.bat) optional configs:
#   SLC_ROI          = AOI shapefile (WGS84) for burst clipping; empty = import all bursts
#   SLC_OUTPUT       = import output dir; empty = same as SLC_DATA
#   SLC_POLARIZATION = ALL_POL / ONLY_VV_POL(default) / ONLY_HH_POL / ONLY_VV_HH_POL
#                     / ONLY_VH_HV_POL / ONLY_VV_VH_POL / ONLY_HH_HV_POL / ONLY_VH_POL / ONLY_HV_POL
#SLC_ROI=
#SLC_OUTPUT=
#SLC_POLARIZATION=ONLY_VV_POL
# ---- DEM preprocessing (run_dem.bat, SARscape 3-step: merge -> ImportEnviOriginal -> ToolsGeoid) ----
#   DEM_RAW    = hgt tile files (space separated, quoted) or glob, e.g. "G:/companion/DEM/*.hgt"
#   DEM_DAT    = step1 merged ENVI .dat (run_dem.bat writes it + .hdr)
#   DEM_ENVI   = step2 ImportEnviOriginal output (GEOIDAL DEM / EGM96)
#   DEM_FINAL  = step3 ToolsGeoid output (SUBTRACT / EGM96) == the DEM used by interferogram
DEM_RAW="D:/work/data/sar/dem/*.hgt"
DEM_DAT=D:/work/data/sar/dem/studyarea.dat
DEM_ENVI=D:/work/data/sar/dem/studyarea.dat_envi
DEM_FINAL=D:/work/data/sar/dem/studyarea_dem
DEM_FILE=D:/work/data/sar/dem/studyarea_dem
GACOS_LIST=D:/work/data/sar/gacos_out_list.txt
SAR_MODULES=D:/work/data/sar_modules.txt

# ---- baseline (读自 config.env；insar_pipeline 扩基线门按 2%->4% 覆盖) ----
MAX_PERC_BASELINE=2
MAX_TIME_BASELINE=180

# ---- processing ----
INTERF_BAT=bat/02_interferogram/run_interf.bat

# ---- software ----
ENVI_IDL=C:/Program Files/Harris/ENVI56/IDL88/bin/bin.x86_64/envi_idl.exe
IDL_EXE=C:/Program Files/Harris/ENVI56/IDL88/bin/bin.x86_64/idl.exe
SARSCAPE_LIB=C:/Program Files/SARMAP SA/SARscape/auxiliary
SKILL_DIR=C:/Users/86155/.pi/agent/skills/insar-genie

DSH_WEB_URL=http://127.0.0.1:3080

# ---- pi-web 唤醒（守护异常/里程碑时实时唤醒 AI）----
# PI_WEB_URL 可留空：守护自动扫描常见端口发现（兼容任意端口）；也可显式指定
PI_WEB_URL=
# PI_WEB_SESSION 可留空：自动从 /api/sessions 取活跃会话；或指定 / 用环境变量 PI_SESSION_ID
PI_WEB_SESSION=
# ---- 通用 pi RPC 唤醒（不依赖 pi-web；RPC_ENABLED=1 时守护 spawn pi --mode rpc）----
RPC_ENABLED=0
RPC_PROVIDER=
RPC_MODEL=
RPC_CMD=pi

